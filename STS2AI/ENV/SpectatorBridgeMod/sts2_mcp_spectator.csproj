<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>sts2_mcp_spectator</AssemblyName>
    <RootNamespace>STS2_MCP</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <STS2AssemblyDir Condition="'$(STS2AssemblyDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\.godot\mono\temp\bin\Debug</STS2AssemblyDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared ENV runtime code. Spectator must not link HeadlessSim-owned sources directly. -->
    <Compile Include="..\Shared\Runtime\*.cs" Link="ENV.Shared\Runtime\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Simulation\*.cs" Link="ENV.Shared\Simulation\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Training\*.cs" Link="ENV.Shared\Training\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Selection\*.cs" Link="ENV.Shared\Selection\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Legacy\*.cs" Link="ENV.Shared\Legacy\%(Filename)%(Extension)" />
    <Protobuf Include="..\proto\game_state.proto" GrpcServices="None" />

    <Reference Include="sts2">
      <HintPath>$(STS2AssemblyDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2AssemblyDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2AssemblyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.68.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sts2_mcp_spectator.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
