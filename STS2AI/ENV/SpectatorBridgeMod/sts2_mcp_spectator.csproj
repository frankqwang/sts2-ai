<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>sts2_mcp_spectator</AssemblyName>
    <RootNamespace>STS2_MCP</RootNamespace>
    <STS2AssemblyDir Condition="'$(STS2AssemblyDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\.godot\mono\temp\bin\Debug</STS2AssemblyDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared DTO types for unified protocol (also compiled into HeadlessSim) -->
    <Compile Include="..\Sim\HeadlessSim\Simulation\FullRunApiStateDtos.cs" Link="Shared\FullRunApiStateDtos.cs" />

    <Reference Include="sts2">
      <HintPath>$(STS2AssemblyDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2AssemblyDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2AssemblyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="sts2_mcp_spectator.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
